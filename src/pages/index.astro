---
import App from '../App.jsx';
import { timelineData } from '../data/timelineData';
import { spectrumBands, startOf, endOf } from '../data/spectrum';

const description =
  'Parth Chandak is a senior creative technologist at Zoox who builds prototyping systems for autonomous vehicles. Named inventor on a published patent application, peer reviewer for Springer Nature, hackathon judge and IEEE Senior Member.';
const shortDescription = 'Inventor, peer reviewer and hackathon judge building prototyping systems for autonomous vehicles.';
const title = 'Parth Chandak | Senior Creative Technologist';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Parth Chandak',
  url: 'https://parthchandak.info/',
  jobTitle: 'Senior Creative Technologist',
  worksFor: { '@type': 'Organization', name: 'Zoox' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Washington State University' },
  sameAs: [
    'https://github.com/parthchandak02',
    'https://linkedin.com/in/parthchandak02',
    'https://patents.google.com/patent/US20260003563A1/en',
  ],
  knowsAbout: ['Rapid prototyping', 'User experience', 'Autonomous vehicles', 'Human-robot interaction', 'Applied AI'],
};

// The record as plain HTML, band by band in the same order as the page, for crawlers, link previews
// and the moment before the app loads. The app replaces it on load.
const record = spectrumBands
  .map((band) => ({
    name: band.name,
    cards: timelineData
      .filter((item) => band.sections.includes(item.category?.toLowerCase()))
      .sort((a, b) => startOf(b.date) - startOf(a.date) || endOf(b.date) - endOf(a.date)),
  }))
  .filter((band) => band.cards.length);
---

<!doctype html>
<html lang="en" class="dark-mode">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="theme-color" content="#000000" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://parthchandak.info/" />
    <meta name="description" content={description} />
    <meta name="author" content="Parth Chandak" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Parth Chandak" />
    <meta property="og:url" content="https://parthchandak.info/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={shortDescription} />
    <meta property="og:image" content="https://parthchandak.info/og-image.png?v=2" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Parth Chandak, Senior Creative Technologist, with a prism splitting light into a spectrum" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={shortDescription} />
    <meta name="twitter:image" content="https://parthchandak.info/og-image.png?v=2" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bitcount+Grid+Single&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Roboto+Condensed:ital,wght@0,100..900;1,100..900&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="dark-mode">
    <div id="root">
      <App client:only="react">
        <main slot="fallback" class="record">
          <h1>Parth Chandak</h1>
          <p>
            Senior creative technologist at Zoox, building prototyping systems for autonomous vehicles, with eight-plus
            years across UX engineering, design technology, AI-assisted prototyping and hardware and software integration.
          </p>
          {
            record.map((band) => (
              <section>
                <h2>{band.name}</h2>
                <ul>
                  {band.cards.map((card) => (
                    <li>
                      {card.url ? <a href={card.url}>{card.title}</a> : card.title}{card.company && `, ${card.company}`}
                      {card.date && <span class="record__when">· {card.date}</span>}
                      {card.description && <p>{card.description}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
          <p>
            <a href="https://github.com/parthchandak02">GitHub</a> · <a href="https://linkedin.com/in/parthchandak02">LinkedIn</a>
          </p>
          <noscript><p>This site is an interactive 3D experience and works best with JavaScript turned on.</p></noscript>
        </main>
      </App>
    </div>
  </body>
</html>

<style is:global>
  .record {
    font-family: system-ui, sans-serif;
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 20px;
    color: #eee;
    background: #000;
    min-height: 100vh;
    line-height: 1.55;
  }
  .record h1 {
    font-weight: 600;
  }
  .record ul {
    padding-left: 1.2em;
  }
  .record li p {
    margin: 0.25em 0 0.9em;
    color: #aaa;
  }
  .record__when {
    color: #999;
  }
  .record a {
    color: #ff8a5c;
  }
</style>
