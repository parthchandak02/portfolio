{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Parth Chandak's portfolio: an Astro site with an interactive React Three Fiber prism, glass UI and a spectrograph of the record",
  "keywords": [
    "react",
    "threejs",
    "3d",
    "prism",
    "visualization",
    "glassmorphism",
    "webgl",
    "interactive",
    "light-refraction",
    "astro"
  ],
  "author": "Parth Chandak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/parthchandak02/Portfolio.git"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "homepage": "https://parthchandak.info",
  "private": true,
  "dependencies": {
    "@astrojs/react": "5.0.7",
    "@react-three/drei": "10.0.7",
    "@react-three/fiber": "9.1.2",
    "@react-three/postprocessing": "3.0.4",
    "@types/three": "0.176.0",
    "astro": "7.4.2",
    "lucide-react": "^0.525.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-typed": "^2.0.12",
    "three": "0.176.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-react": "^7.37.5",
    "kill-port": "^2.0.1",
    "postprocessing": "^6.37.6",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.8",
    "sharp": "^0.35.5",
    "three-stdlib": "^2.36.0"
  },
  "scripts": {
    "cleanup:port": "node -e \"const {execSync}=require('node:child_process');try{const pids=execSync('lsof -ti tcp:3000',{stdio:['ignore','pipe','ignore']}).toString().trim();if(pids){execSync('kill-port 3000',{stdio:'ignore'});}}catch(_){process.exit(0);}\"",
    "prestart": "npm run cleanup:port",
    "start": "npm run start:app",
    "predev": "npm run cleanup:port",
    "dev": "npm run start:app",
    "start:app": "astro dev --port 3000",
    "build": "astro build",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\"",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "health": "npm outdated && npm audit",
    "outdated": "npm outdated",
    "clean": "rimraf build",
    "preview": "astro preview --port 3000",
    "deploy": "npm run build && wrangler pages deploy build --project-name portfolio --branch main --commit-dirty=true"
  },
  "type": "module"
}
